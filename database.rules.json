{
  "rules": {
    ".read": true,
    ".write": false,
    "meals": {
      "$date": {
        "$meal": {
          "rating": {
            "totalScore": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000000"
            },
            "voterCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "users": {
              "$uid": {
                ".write": "auth != null && $uid === auth.uid && $date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && ($meal === 'lunch' || $meal === 'dinner') && newData.exists()",
                ".validate": "newData.hasChildren(['score', 'active']) && newData.child('score').isNumber() && newData.child('active').isBoolean() && ((newData.child('active').val() === true && newData.child('score').val() >= 1 && newData.child('score').val() <= 5) || (newData.child('active').val() === false && newData.child('score').val() === 0))",
                "score": {
                  ".validate": "newData.isNumber()"
                },
                "active": {
                  ".validate": "newData.isBoolean()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "comments": {
            "$commentId": {
              ".write": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && ($meal === 'lunch' || $meal === 'dinner') && newData.exists() && ((!data.exists() && newData.child('likes').val() === 0) || (data.exists() && data.child('likes').isNumber() && newData.child('text').val() === data.child('text').val() && newData.child('timestamp').val() === data.child('timestamp').val() && newData.child('likes').val() === data.child('likes').val() + 1))",
              ".validate": "newData.hasChildren(['text', 'timestamp', 'likes'])",
              "text": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
              },
              "timestamp": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
              },
              "likes": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "polls": {
      "$date": {
        "$meal": {
          "$choice": {
            ".write": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && ($meal === 'lunch' || $meal === 'dinner') && $choice.matches(/^[0-9]{1,2}$/) && newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.isNumber() && newData.val() === data.val() + 1))",
            ".validate": "newData.val() >= 1 && newData.val() <= 1000000"
          }
        }
      }
    },
    "suggestions": {
      "$suggestionId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['text', 'timestamp'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
        },
        "timestamp": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
