{
  "rules": {
    ".read": false,
    ".write": false,
    "meals": {
      "$date": {
        "$meal": {
          "rating": {
            ".read": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && ($meal === 'lunch' || $meal === 'dinner')",
            "totalScore": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000000"
            },
            "voterCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "users": {
              "$uid": {
                ".write": "auth != null && $uid === auth.uid && $date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && ($meal === 'lunch' || $meal === 'dinner') && newData.exists()",
                ".validate": "newData.hasChildren(['score', 'active']) && newData.child('score').isNumber() && newData.child('active').isBoolean() && ((newData.child('active').val() === true && newData.child('score').val() >= 1 && newData.child('score').val() <= 5) || (newData.child('active').val() === false && newData.child('score').val() === 0))",
                "score": {
                  ".validate": "newData.isNumber()"
                },
                "active": {
                  ".validate": "newData.isBoolean()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "comments": {
            ".read": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && ($meal === 'lunch' || $meal === 'dinner')",
            "$commentId": {
              ".write": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && ($meal === 'lunch' || $meal === 'dinner') && newData.exists() && ((!data.exists() && newData.child('likes').val() === 0) || (data.exists() && data.child('likes').isNumber() && newData.child('text').val() === data.child('text').val() && newData.child('timestamp').val() === data.child('timestamp').val() && newData.child('likes').val() === data.child('likes').val() + 1))",
              ".validate": "newData.hasChildren(['text', 'timestamp', 'likes'])",
              "text": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
              },
              "timestamp": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
              },
              "likes": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "polls": {
      "$date": {
        "$meal": {
          ".read": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && ($meal === 'lunch' || $meal === 'dinner')",
          "$choice": {
            ".write": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && ($meal === 'lunch' || $meal === 'dinner') && $choice.matches(/^[0-9]{1,2}$/) && newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.isNumber() && newData.val() === data.val() + 1))",
            ".validate": "newData.val() >= 1 && newData.val() <= 1000000"
          }
        }
      }
    },
    "commentReplies": {
      "$date": {
        "$meal": {
          ".read": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && ($meal === 'lunch' || $meal === 'dinner')",
          "$commentId": {
            ".write": "auth != null && auth.token.email === 'bjt77@baejeong.hs.kr' && root.child('meals').child($date).child($meal).child('comments').child($commentId).exists()",
            ".validate": "!newData.exists() || newData.hasChildren(['content', 'createdAt', 'updatedAt', 'authorRole'])",
            "content": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
            },
            "createdAt": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100 && (!data.exists() || newData.val() === data.val())"
            },
            "updatedAt": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
            },
            "authorRole": {
              ".validate": "newData.val() === 'teacher'"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "suggestions": {
      ".read": true,
      "$suggestionId": {
        ".write": "(!data.exists() && newData.exists() && auth != null && auth.token.firebase.sign_in_provider === 'google.com' && newData.parent().parent().child('suggestionAuthors').child($suggestionId).child('authorUid').val() === auth.uid) || (auth != null && auth.token.email === 'bjt77@baejeong.hs.kr' && data.exists() && !newData.exists())",
        ".validate": "newData.hasChildren(['content', 'createdAt'])",
        "content": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "suggestionReplies": {
      ".read": true,
      "$suggestionId": {
        ".write": "auth != null && auth.token.email === 'bjt77@baejeong.hs.kr' && root.child('suggestions').child($suggestionId).exists()",
        ".validate": "!newData.exists() || newData.hasChildren(['content', 'createdAt', 'updatedAt', 'authorRole'])",
        "content": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100 && (!data.exists() || newData.val() === data.val())"
        },
        "updatedAt": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "authorRole": {
          ".validate": "newData.val() === 'teacher'"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "suggestionAuthors": {
      ".read": "auth != null && auth.token.email === 'bjt77@baejeong.hs.kr'",
      "$suggestionId": {
        ".write": "(!data.exists() && newData.exists() && auth != null && auth.token.firebase.sign_in_provider === 'google.com' && newData.child('authorUid').val() === auth.uid && newData.parent().parent().child('suggestions').child($suggestionId).exists()) || (auth != null && auth.token.email === 'bjt77@baejeong.hs.kr' && !newData.exists())",
        ".validate": "newData.hasChildren(['authorUid', 'authorName'])",
        "authorUid": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "authorName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "settings": {
      "bgmVideoId": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'bjt77@baejeong.hs.kr'",
        ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{11}$/)"
      },
      "bgmUpdatedAt": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'bjt77@baejeong.hs.kr'",
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "$other": {
        ".validate": false
      }
    },
    "bgmRequests": {
      ".read": true,
      "$requestId": {
        ".write": "(!data.exists() && newData.exists() && auth != null && auth.token.firebase.sign_in_provider === 'google.com' && newData.parent().parent().child('bgmRequestAuthors').child($requestId).child('requesterUid').val() === auth.uid) || (auth != null && auth.token.email === 'bjt77@baejeong.hs.kr')",
        ".validate": "!newData.exists() || newData.hasChildren(['title', 'videoId', 'createdAt', 'status'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100 && (!data.exists() || newData.val() === data.val())"
        },
        "videoId": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{11}$/) && (!data.exists() || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100 && (!data.exists() || newData.val() === data.val())"
        },
        "status": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'applied' || newData.val() === 'hold' || newData.val() === 'rejected'"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "bgmRequestAuthors": {
      ".read": "auth != null && auth.token.email === 'bjt77@baejeong.hs.kr'",
      "$requestId": {
        ".write": "(!data.exists() && newData.exists() && auth != null && auth.token.firebase.sign_in_provider === 'google.com' && newData.child('requesterUid').val() === auth.uid && newData.parent().parent().child('bgmRequests').child($requestId).exists()) || (auth != null && auth.token.email === 'bjt77@baejeong.hs.kr' && !newData.exists())",
        ".validate": "newData.hasChildren(['requesterUid', 'requesterName', 'message'])",
        "requesterUid": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "requesterName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
